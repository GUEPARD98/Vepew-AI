<?xml version="1.0" encoding="UTF-8"?>
<!--
VPEW-AI Optimized Sysmon Configuration
Enhanced telemetry collection for threat detection

This configuration is optimized for:
- Process creation monitoring
- Network connection tracking  
- File system activity
- Registry modifications
- Process access (credential dumping detection)
- DNS queries
- Image/DLL loads

Version: 1.0
Author: VPEW-AI Team
-->

<Sysmon schemaversion="4.82">
  <!-- Capture all hashes by default -->
  <HashAlgorithms>md5,sha256,IMPHASH</HashAlgorithms>
  
  <!-- Log all DNS queries -->
  <DnsLookup>True</DnsLookup>
  
  <!-- Archive deleted files for forensics -->
  <ArchiveDirectory>C:\Sysmon\Archive</ArchiveDirectory>
  
  <EventFiltering>
    
    <!-- Event ID 1: Process Creation -->
    <RuleGroup name="" groupRelation="or">
      <ProcessCreate onmatch="exclude">
        <!-- Exclude noisy but legitimate processes -->
        <Image condition="is">C:\Windows\System32\conhost.exe</Image>
        <Image condition="is">C:\Windows\System32\wbem\WmiPrvSE.exe</Image>
        <Image condition="is">C:\Windows\System32\dllhost.exe</Image>
        <Image condition="end with">Microsoft\Windows\WindowsUpdate\UpdateAssistant\UpdateAssistant.exe</Image>
        
        <!-- Exclude common legitimate parent-child relationships -->
        <ParentImage condition="is">C:\Windows\System32\services.exe</ParentImage>
        <ParentImage condition="is">C:\Windows\System32\wininit.exe</ParentImage>
        <ParentImage condition="is">C:\Windows\System32\winlogon.exe</ParentImage>
      </ProcessCreate>
    </RuleGroup>

    <!-- Event ID 2: File Creation Time Changed -->
    <RuleGroup name="" groupRelation="or">
      <FileCreateTime onmatch="include">
        <!-- Monitor timestomping in critical directories -->
        <TargetFilename condition="begin with">C:\Windows\System32</TargetFilename>
        <TargetFilename condition="begin with">C:\Windows\SysWOW64</TargetFilename>
        <TargetFilename condition="begin with">C:\Program Files</TargetFilename>
      </FileCreateTime>
    </RuleGroup>

    <!-- Event ID 3: Network Connection -->
    <RuleGroup name="" groupRelation="or">
      <NetworkConnect onmatch="exclude">
        <!-- Exclude local/internal communications -->
        <DestinationIp condition="begin with">10.</DestinationIp>
        <DestinationIp condition="begin with">192.168.</DestinationIp>
        <DestinationIp condition="begin with">172.16.</DestinationIp>
        <DestinationIp condition="begin with">127.</DestinationIp>
        <DestinationIp condition="is">::1</DestinationIp>
        
        <!-- Exclude known legitimate processes -->
        <Image condition="end with">\chrome.exe</Image>
        <Image condition="end with">\firefox.exe</Image>
        <Image condition="end with">\iexplore.exe</Image>
        <Image condition="end with">\msedge.exe</Image>
        
        <!-- Exclude Windows Update -->
        <Image condition="begin with">C:\Windows\System32\</Image>
        <DestinationHostname condition="end with">microsoft.com</DestinationHostname>
        <DestinationHostname condition="end with">windows.com</DestinationHostname>
      </NetworkConnect>
    </RuleGroup>

    <!-- Event ID 5: Process Terminated -->
    <RuleGroup name="" groupRelation="or">
      <ProcessTerminate onmatch="include">
        <!-- Monitor termination of security processes -->
        <Image condition="end with">\taskmgr.exe</Image>
        <Image condition="end with">\procexp.exe</Image>
        <Image condition="end with">\procexp64.exe</Image>
        <Image condition="contains">antivirus</Image>
        <Image condition="contains">defender</Image>
      </ProcessTerminate>
    </RuleGroup>

    <!-- Event ID 6: Driver Loaded -->
    <RuleGroup name="" groupRelation="or">
      <DriverLoad onmatch="exclude">
        <!-- Exclude signed Microsoft drivers -->
        <Signature condition="is">Microsoft Windows</Signature>
        <Signature condition="is">Microsoft Corporation</Signature>
        <Signed condition="is">true</Signed>
      </DriverLoad>
    </RuleGroup>

    <!-- Event ID 7: Image Loaded -->
    <RuleGroup name="" groupRelation="or">
      <ImageLoad onmatch="include">
        <!-- Monitor DLL loads in critical processes -->
        <Image condition="end with">\lsass.exe</Image>
        <Image condition="end with">\winlogon.exe</Image>
        <Image condition="end with">\csrss.exe</Image>
        
        <!-- Monitor unsigned DLL loads -->
        <Signed condition="is">false</Signed>
      </ImageLoad>
    </RuleGroup>

    <!-- Event ID 8: CreateRemoteThread -->
    <RuleGroup name="" groupRelation="or">
      <CreateRemoteThread onmatch="exclude">
        <!-- Exclude legitimate remote thread creation -->
        <SourceImage condition="is">C:\Windows\System32\wbem\WmiPrvSE.exe</SourceImage>
        <SourceImage condition="is">C:\Windows\System32\svchost.exe</SourceImage>
        <TargetImage condition="is">C:\Windows\System32\wbem\WmiPrvSE.exe</TargetImage>
      </CreateRemoteThread>
    </RuleGroup>

    <!-- Event ID 9: RawAccessRead -->
    <RuleGroup name="" groupRelation="or">
      <RawAccessRead onmatch="exclude">
        <!-- Exclude legitimate disk access -->
        <Image condition="is">C:\Windows\System32\FsUtil.exe</Image>
        <Image condition="is">C:\Windows\System32\defrag.exe</Image>
      </RawAccessRead>
    </RuleGroup>

    <!-- Event ID 10: Process Access -->
    <RuleGroup name="" groupRelation="or">
      <ProcessAccess onmatch="include">
        <!-- Monitor LSASS access (credential dumping) -->
        <TargetImage condition="end with">\lsass.exe</TargetImage>
        
        <!-- Monitor access to other critical processes -->
        <TargetImage condition="end with">\winlogon.exe</TargetImage>
        <TargetImage condition="end with">\csrss.exe</TargetImage>
        <TargetImage condition="end with">\services.exe</TargetImage>
      </ProcessAccess>
    </RuleGroup>

    <!-- Event ID 11: File Create -->
    <RuleGroup name="" groupRelation="or">
      <FileCreate onmatch="include">
        <!-- Monitor executable creation in suspicious locations -->
        <TargetFilename condition="end with">.exe</TargetFilename>
        <TargetFilename condition="end with">.scr</TargetFilename>
        <TargetFilename condition="end with">.bat</TargetFilename>
        <TargetFilename condition="end with">.cmd</TargetFilename>
        <TargetFilename condition="end with">.ps1</TargetFilename>
        <TargetFilename condition="end with">.vbs</TargetFilename>
        <TargetFilename condition="end with">.js</TargetFilename>
        
        <!-- Monitor creation in suspicious directories -->
        <TargetFilename condition="begin with">C:\Users\Public\</TargetFilename>
        <TargetFilename condition="begin with">C:\ProgramData\</TargetFilename>
        <TargetFilename condition="contains">\Temp\</TargetFilename>
        <TargetFilename condition="contains">\AppData\Roaming\</TargetFilename>
      </FileCreate>
    </RuleGroup>

    <!-- Event ID 12: Registry Object Create/Delete -->
    <RuleGroup name="" groupRelation="or">
      <RegistryEvent onmatch="include">
        <!-- Monitor persistence registry keys -->
        <TargetObject condition="contains">CurrentVersion\Run</TargetObject>
        <TargetObject condition="contains">CurrentVersion\RunOnce</TargetObject>
        <TargetObject condition="contains">CurrentVersion\RunServices</TargetObject>
        <TargetObject condition="contains">CurrentVersion\RunServicesOnce</TargetObject>
        <TargetObject condition="contains">Group Policy\Scripts</TargetObject>
        <TargetObject condition="contains">Windows\System\Scripts</TargetObject>
        
        <!-- Monitor service creation -->
        <TargetObject condition="contains">ControlSet001\Services\</TargetObject>
        <TargetObject condition="contains">ControlSet002\Services\</TargetObject>
        
        <!-- Monitor security-related keys -->
        <TargetObject condition="contains">Policies\System\</TargetObject>
        <TargetObject condition="contains">Windows\CurrentVersion\Policies\</TargetObject>
        <TargetObject condition="contains">Control\SecurityProviders\</TargetObject>
      </RegistryEvent>
    </RuleGroup>

    <!-- Event ID 13: Registry Value Set -->
    <RuleGroup name="" groupRelation="or">
      <RegistryEvent onmatch="include">
        <!-- Same as Event ID 12 - monitor critical registry modifications -->
        <TargetObject condition="contains">CurrentVersion\Run</TargetObject>
        <TargetObject condition="contains">CurrentVersion\RunOnce</TargetObject>
        <TargetObject condition="contains">CurrentVersion\RunServices</TargetObject>
        <TargetObject condition="contains">CurrentVersion\RunServicesOnce</TargetObject>
        <TargetObject condition="contains">Group Policy\Scripts</TargetObject>
        <TargetObject condition="contains">Windows\System\Scripts</TargetObject>
        <TargetObject condition="contains">ControlSet001\Services\</TargetObject>
        <TargetObject condition="contains">ControlSet002\Services\</TargetObject>
        <TargetObject condition="contains">Policies\System\</TargetObject>
        <TargetObject condition="contains">Windows\CurrentVersion\Policies\</TargetObject>
        <TargetObject condition="contains">Control\SecurityProviders\</TargetObject>
        
        <!-- Monitor Windows Defender exclusions -->
        <TargetObject condition="contains">Windows Defender\Exclusions\</TargetObject>
      </RegistryEvent>
    </RuleGroup>

    <!-- Event ID 14: Registry Key/Value Rename -->
    <RuleGroup name="" groupRelation="or">
      <RegistryEvent onmatch="include">
        <!-- Monitor all registry renames (potentially evasive) -->
        <EventType condition="is">RenameKey</EventType>
      </RegistryEvent>
    </RuleGroup>

    <!-- Event ID 15: FileCreateStreamHash -->
    <RuleGroup name="" groupRelation="or">
      <FileCreateStreamHash onmatch="include">
        <!-- Monitor ADS (Alternate Data Streams) creation -->
        <TargetFilename condition="contains">:</TargetFilename>
      </FileCreateStreamHash>
    </RuleGroup>

    <!-- Event ID 17: Pipe Created -->
    <RuleGroup name="" groupRelation="or">
      <PipeEvent onmatch="include">
        <!-- Monitor named pipes (often used by malware) -->
        <PipeName condition="begin with">\</PipeName>
      </PipeEvent>
    </RuleGroup>

    <!-- Event ID 18: Pipe Connected -->
    <RuleGroup name="" groupRelation="or">
      <PipeEvent onmatch="include">
        <!-- Monitor pipe connections -->
        <PipeName condition="begin with">\</PipeName>
      </PipeEvent>
    </RuleGroup>

    <!-- Event ID 19: WmiEventFilter -->
    <RuleGroup name="" groupRelation="or">
      <WmiEvent onmatch="exclude">
        <!-- Exclude legitimate WMI activity -->
        <Operation condition="is">Created</Operation>
        <Consumer condition="contains">Microsoft</Consumer>
      </WmiEvent>
    </RuleGroup>

    <!-- Event ID 20: WmiEventConsumer -->
    <RuleGroup name="" groupRelation="or">
      <WmiEvent onmatch="exclude">
        <!-- Exclude legitimate WMI consumers -->
        <Operation condition="is">Created</Operation>
        <Consumer condition="contains">Microsoft</Consumer>
      </WmiEvent>
    </RuleGroup>

    <!-- Event ID 21: WmiEventConsumerToFilter -->
    <RuleGroup name="" groupRelation="or">
      <WmiEvent onmatch="exclude">
        <!-- Exclude legitimate WMI bindings -->
        <Operation condition="is">Created</Operation>
        <Consumer condition="contains">Microsoft</Consumer>
      </WmiEvent>
    </RuleGroup>

    <!-- Event ID 22: DNS Query -->
    <RuleGroup name="" groupRelation="or">
      <DnsQuery onmatch="exclude">
        <!-- Exclude internal DNS queries -->
        <QueryName condition="end with">.local</QueryName>
        <QueryName condition="end with">.internal</QueryName>
        <QueryName condition="contains">wpad</QueryName>
        
        <!-- Exclude common legitimate domains -->
        <QueryName condition="end with">microsoft.com</QueryName>
        <QueryName condition="end with">windows.com</QueryName>
        <QueryName condition="end with">office.com</QueryName>
        <QueryName condition="end with">live.com</QueryName>
        <QueryName condition="end with">msftncsi.com</QueryName>
        
        <!-- Exclude reverse DNS lookups -->
        <QueryName condition="end with">.in-addr.arpa</QueryName>
        <QueryName condition="end with">.ip6.arpa</QueryName>
      </DnsQuery>
    </RuleGroup>

    <!-- Event ID 23: FileDelete -->
    <RuleGroup name="" groupRelation="or">
      <FileDelete onmatch="include">
        <!-- Monitor deletion of security tools -->
        <TargetFilename condition="contains">antivirus</TargetFilename>
        <TargetFilename condition="contains">defender</TargetFilename>
        <TargetFilename condition="contains">malware</TargetFilename>
        
        <!-- Monitor log file deletion -->
        <TargetFilename condition="end with">.log</TargetFilename>
        <TargetFilename condition="end with">.evtx</TargetFilename>
        
        <!-- Monitor deletion in system directories -->
        <TargetFilename condition="begin with">C:\Windows\System32\</TargetFilename>
        <TargetFilename condition="begin with">C:\Windows\SysWOW64\</TargetFilename>
      </FileDelete>
    </RuleGroup>

    <!-- Event ID 24: ClipboardChange -->
    <RuleGroup name="" groupRelation="or">
      <ClipboardChange onmatch="include">
        <!-- Monitor clipboard for sensitive data -->
        <ClientInfo condition="contains">password</ClientInfo>
        <ClientInfo condition="contains">credential</ClientInfo>
        <ClientInfo condition="contains">token</ClientInfo>
        <ClientInfo condition="contains">secret</ClientInfo>
      </ClipboardChange>
    </RuleGroup>

    <!-- Event ID 25: ProcessTampering -->
    <RuleGroup name="" groupRelation="or">
      <ProcessTampering onmatch="include">
        <!-- Monitor all process tampering -->
        <Type condition="is">Image replaced</Type>
      </ProcessTampering>
    </RuleGroup>

    <!-- Event ID 26: FileDeleteDetected -->
    <RuleGroup name="" groupRelation="or">
      <FileDeleteDetected onmatch="include">
        <!-- Monitor all file deletions for forensics -->
        <TargetFilename condition="end with">.exe</TargetFilename>
        <TargetFilename condition="end with">.dll</TargetFilename>
        <TargetFilename condition="end with">.sys</TargetFilename>
      </FileDeleteDetected>
    </RuleGroup>

  </EventFiltering>
</Sysmon>
